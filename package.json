{
  "name": "lastdictionary",
  "version": "1.0.0",
  "private": true,
  "description": "The Last Dictionary: intelligence, human and otherwise. Every word of AI, defined in plain words first, then precisely, with the year it was born.",
  "homepage": "https://lastdictionary.com/",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm build:data && next dev",
    "build": "pnpm build:data && next build",
    "build:data": "tsx scripts/build-data.ts",
    "validate": "tsx scripts/validate.ts",
    "new-entry": "tsx scripts/new-entry.ts",
    "migrate:extract": "tsx scripts/migrate/extract.ts",
    "migrate:verify": "tsx scripts/migrate/verify.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "pnpm validate && pnpm typecheck && pnpm lint && pnpm test",
    "a11y": "tsx scripts/a11y.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "gpt-tokenizer": "^4.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.64.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
